ANTHROPIC_API_KEY=
MODEL=anthropic:claude-sonnet-5-5

# Cheaper options and other providers: see docs/MODELS.md. For example:
# MODEL=anthropic:claude-haiku-5-5
# MODEL_GRADER=anthropic:claude-sonnet-5-5
#
# Per-agent overrides (each falls back to MODEL when blank):
# MODEL_WITNESS=
# MODEL_CHECKER=
# MODEL_CRITERIA=
# MODEL_GRADER=
#
# Other providers' keys:
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Voice and face services (optional; see docs/VOICE-AND-FACE.md):
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=
# SIMLI_API_KEY=
# SIMLI_FACE_ID=
# DID_API_KEY=
# DID_SOURCE_URL=
# TAVUS_API_KEY=
# TAVUS_FACE_ID=
# HEYGEN_API_KEY=

# Online only (see docs/PUBLISHING.md on the online branch): set these in your hosting service, not here.
# APP_PASSWORD=
# MAX_INTERVIEWS_PER_DAY=10
# MAX_QUESTIONS_PER_INTERVIEW=60
# ALLOWED_HOSTS=your-app.onrender.com

# Testing only: show the witness's persona during the interview (normally hidden until grading).
# REVEAL_PERSONA=1

# Saved interviews go to your local app-data folder. Uncomment to stop saving them:
# SAVE_SESSIONS=0

# MOCK_LLM=1
